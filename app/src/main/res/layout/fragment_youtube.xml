<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/safe_h"
    android:paddingTop="@dimen/safe_v"
    android:paddingEnd="@dimen/safe_h">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Tabs (Movies & TV screen only), like Watcho: Movies / Videos / TV Channels -->
        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView android:id="@+id/tab_1" style="@style/TvButton" android:textStyle="bold" />
            <TextView android:id="@+id/tab_2" style="@style/TvButton" android:textStyle="bold" />
            <TextView android:id="@+id/tab_3" style="@style/TvButton" android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_body" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Search row -->
    <LinearLayout
        android:id="@+id/search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_focusable"
            android:hint="@string/yt_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/btn_search"
            style="@style/TvButton"
            android:text="@string/yt_search" />

        <TextView
            android:id="@+id/btn_voice"
            style="@style/TvButton"
            android:text="@string/yt_voice"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_app"
            style="@style/TvButton"
            android:layout_marginEnd="0dp"
            android:text="@string/yt_open_app" />
    </LinearLayout>

    <!-- Year buttons (Movies tab only) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/years"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <!-- Category chips -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="@dimen/safe_v" />

        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxWidth="680dp"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
